const __vite__css = "/* ============================================================\r\n   FRESHERS 2026 — global styles\r\n   Design system: near-black, frosted glass, violet/electric-blue\r\n   illumination, editorial display type (Syne) + readable body (Inter).\r\n   ============================================================ */\r\n\r\n:root {\r\n  --bg: #05060a;\r\n  --bg-2: #070a14;\r\n  --ink: #eaf0ff;\r\n  --ink-dim: #a7b2cc;\r\n  --ink-faint: #6b768f;\r\n  --violet: #7b5cff;\r\n  --electric: #2f7dff;\r\n  --cool: #dbe7ff;\r\n  --gold: #f3c675;\r\n  --amber: #ffb457;\r\n  --edge: rgba(255, 255, 255, 0.12);\r\n  --edge-hi: rgba(255, 255, 255, 0.35);\r\n\r\n  --font-display: 'Syne', 'Inter', system-ui, sans-serif;\r\n  --font-body: 'Inter', system-ui, -apple-system, Segoe UI, Roboto, sans-serif;\r\n\r\n  --radius: 24px;\r\n  --accent: var(--violet); /* per-panel override for personalised paths */\r\n}\r\n\r\n*,\r\n*::before,\r\n*::after {\r\n  box-sizing: border-box;\r\n}\r\n\r\nhtml,\r\nbody,\r\n#root {\r\n  height: 100%;\r\n}\r\n\r\nbody {\r\n  margin: 0;\r\n  background: radial-gradient(120% 120% at 50% 0%, var(--bg-2), var(--bg) 60%);\r\n  color: var(--ink);\r\n  font-family: var(--font-body);\r\n  font-size: 16px;\r\n  line-height: 1.6;\r\n  -webkit-font-smoothing: antialiased;\r\n  text-rendering: optimizeLegibility;\r\n  overflow-x: hidden;\r\n}\r\n\r\nh1,\r\nh2,\r\nh3,\r\np {\r\n  margin: 0;\r\n}\r\n\r\nbutton {\r\n  font-family: inherit;\r\n  cursor: pointer;\r\n}\r\n\r\n/* Accessibility helper — visually hidden but available to screen readers. */\r\n.sr-only {\r\n  position: absolute;\r\n  width: 1px;\r\n  height: 1px;\r\n  padding: 0;\r\n  margin: -1px;\r\n  overflow: hidden;\r\n  clip: rect(0, 0, 0, 0);\r\n  white-space: nowrap;\r\n  border: 0;\r\n}\r\n\r\n/* Consistent, visible focus for keyboard users. */\r\n:focus-visible {\r\n  outline: 2px solid var(--cool);\r\n  outline-offset: 3px;\r\n  border-radius: 6px;\r\n}\r\n\r\n/* ============================================================ Layout */\r\n\r\n.app {\r\n  position: relative;\r\n  min-height: 100dvh;\r\n}\r\n\r\n.app__scene {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 0;\r\n}\r\n\r\n.app__scene canvas {\r\n  display: block;\r\n  width: 100% !important;\r\n  height: 100% !important;\r\n}\r\n\r\n.app__overlay {\r\n  position: relative;\r\n  z-index: 2;\r\n  min-height: 100dvh;\r\n  /* Flex + margin:auto keeps tall panels fully reachable (never clipped at the\r\n     top like grid/flex centering does when content overflows the viewport). */\r\n  display: flex;\r\n  justify-content: center;\r\n  /* Let pointer events fall through the empty overlay area to the canvas, so\r\n     the WebGL scene keeps receiving move events for parallax. */\r\n  pointer-events: none;\r\n  padding: clamp(1.25rem, 4vw, 3rem);\r\n  padding-top: max(clamp(1.25rem, 4vw, 3rem), calc(env(safe-area-inset-top) + 4.5rem));\r\n  padding-bottom: max(clamp(1.25rem, 4vw, 3rem), calc(env(safe-area-inset-bottom) + 2rem));\r\n}\r\n\r\n.stage-overlay {\r\n  width: 100%;\r\n  max-width: 100vw;\r\n  margin: auto; /* safe centre */\r\n  display: flex;\r\n  justify-content: center;\r\n  pointer-events: auto; /* re-enable interaction for the interface layer */\r\n}\r\n\r\n/* Enter animation replayed on every stage change (see StageOverlay key). */\r\n.stage-anim {\r\n  width: 100%;\r\n  display: flex;\r\n  justify-content: center;\r\n  animation: stage-enter 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;\r\n}\r\n\r\n@keyframes stage-enter {\r\n  from {\r\n    opacity: 0;\r\n    transform: translateY(18px);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: none;\r\n  }\r\n}\r\n\r\n.stage {\r\n  width: 100%;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  text-align: center;\r\n}\r\n\r\n/* ============================================================ Journey chrome */\r\n\r\n.controls {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  right: 0;\r\n  z-index: 3;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 1rem;\r\n  padding: max(0.9rem, calc(env(safe-area-inset-top) + 0.75rem)) clamp(1rem, 4vw, 2rem) 0.9rem;\r\n  pointer-events: none;\r\n}\r\n\r\n.controls__brand {\r\n  font-family: var(--font-display);\r\n  font-weight: 800;\r\n  letter-spacing: 0.18em;\r\n  font-size: 0.8rem;\r\n  color: var(--ink-dim);\r\n  text-transform: uppercase;\r\n}\r\n\r\n.controls__meter {\r\n  display: flex;\r\n  gap: 0.5rem;\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\n.controls__dot {\r\n  width: 22px;\r\n  height: 4px;\r\n  border-radius: 999px;\r\n  background: rgba(255, 255, 255, 0.14);\r\n  transition: background 0.4s ease;\r\n}\r\n\r\n.controls__dot.is-done {\r\n  background: rgba(255, 255, 255, 0.32);\r\n}\r\n\r\n.controls__dot.is-active {\r\n  background: linear-gradient(90deg, var(--electric), var(--violet));\r\n}\r\n\r\n.controls__restart {\r\n  pointer-events: auto;\r\n  background: transparent;\r\n  border: 1px solid var(--edge);\r\n  color: var(--ink-dim);\r\n  padding: 0.4rem 0.85rem;\r\n  border-radius: 999px;\r\n  font-size: 0.78rem;\r\n  letter-spacing: 0.04em;\r\n  transition: color 0.25s ease, border-color 0.25s ease;\r\n}\r\n\r\n.controls__restart:hover {\r\n  color: var(--ink);\r\n  border-color: var(--edge-hi);\r\n}\r\n\r\n/* ============================================================ Glass panel */\r\n\r\n.glass-panel {\r\n  position: relative;\r\n  width: 100%;\r\n  max-width: min(680px, 94vw);\r\n  padding: clamp(1.6rem, 3.4vw, 2.6rem);\r\n  border-radius: var(--radius);\r\n  background: linear-gradient(\r\n    160deg,\r\n    rgba(255, 255, 255, 0.08),\r\n    rgba(255, 255, 255, 0.02) 45%,\r\n    rgba(120, 140, 255, 0.04)\r\n  );\r\n  border: 1px solid var(--edge);\r\n  box-shadow:\r\n    0 40px 90px -30px rgba(0, 0, 0, 0.8),\r\n    inset 0 1px 0 rgba(255, 255, 255, 0.16);\r\n  backdrop-filter: blur(20px) saturate(125%);\r\n  -webkit-backdrop-filter: blur(20px) saturate(125%);\r\n  overflow: hidden;\r\n}\r\n\r\n/* Thin illuminated top edge. */\r\n.glass-panel::before {\r\n  content: '';\r\n  position: absolute;\r\n  inset: 0 0 auto 0;\r\n  height: 1px;\r\n  background: linear-gradient(\r\n    90deg,\r\n    transparent,\r\n    rgba(255, 255, 255, 0.55),\r\n    transparent\r\n  );\r\n  opacity: 0.7;\r\n}\r\n\r\n.panel__kicker {\r\n  font-size: 0.82rem;\r\n  letter-spacing: 0.28em;\r\n  text-transform: uppercase;\r\n  color: var(--accent);\r\n  font-weight: 600;\r\n  margin-bottom: 1rem;\r\n}\r\n\r\n.panel__title {\r\n  font-family: var(--font-display);\r\n  font-weight: 800;\r\n  font-size: clamp(1.7rem, 5.4vw, 2.9rem);\r\n  line-height: 1.08;\r\n  letter-spacing: -0.01em;\r\n  margin-bottom: 1rem;\r\n}\r\n\r\n.panel__title--story {\r\n  font-size: clamp(1.5rem, 4.6vw, 2.4rem);\r\n}\r\n\r\n.panel__body {\r\n  color: var(--ink-dim);\r\n  font-size: clamp(1rem, 2.4vw, 1.12rem);\r\n  max-width: 46ch;\r\n  margin: 0 auto 1.5rem;\r\n}\r\n\r\n.panel__note {\r\n  color: var(--ink-faint);\r\n  font-size: 0.82rem;\r\n  margin-top: 1.2rem;\r\n}\r\n\r\n.panel__actions {\r\n  display: flex;\r\n  gap: 0.8rem;\r\n  justify-content: center;\r\n  flex-wrap: wrap;\r\n  margin-top: 0.5rem;\r\n}\r\n\r\n/* ============================================================ Buttons */\r\n\r\n.btn {\r\n  position: relative;\r\n  border-radius: 999px;\r\n  padding: 0.85rem 1.7rem;\r\n  font-size: 0.98rem;\r\n  font-weight: 600;\r\n  letter-spacing: 0.01em;\r\n  border: 1px solid transparent;\r\n  transition: transform 0.2s ease, box-shadow 0.3s ease, background 0.3s ease, opacity 0.2s ease;\r\n  min-height: 44px;\r\n  touch-action: manipulation;\r\n}\r\n\r\n.btn:active {\r\n  transform: translateY(1px) scale(0.99);\r\n}\r\n\r\n.btn:disabled {\r\n  opacity: 0.4;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.btn--primary {\r\n  color: #0a0c14;\r\n  background: linear-gradient(120deg, #ffffff, #cfe0ff 40%, #b9c6ff);\r\n  box-shadow:\r\n    0 10px 30px -10px rgba(120, 150, 255, 0.7),\r\n    inset 0 0 0 1px rgba(255, 255, 255, 0.5);\r\n}\r\n\r\n.btn--primary:hover:not(:disabled) {\r\n  box-shadow:\r\n    0 16px 40px -12px rgba(120, 150, 255, 0.85),\r\n    inset 0 0 0 1px rgba(255, 255, 255, 0.6);\r\n}\r\n\r\n.btn--ghost {\r\n  color: var(--ink);\r\n  background: rgba(255, 255, 255, 0.04);\r\n  border-color: var(--edge);\r\n}\r\n\r\n.btn--ghost:hover {\r\n  background: rgba(255, 255, 255, 0.09);\r\n  border-color: var(--edge-hi);\r\n}\r\n\r\n/* ============================================================ Hero */\r\n\r\n/* The visible title is real 3D in the canvas; the overlay fills the viewport\r\n   with the subline at the top and the enter control toward the bottom, leaving\r\n   the centre for the rotating typography. */\r\n.stage--hero {\r\n  width: 100%;\r\n  min-height: min(82vh, 760px);\r\n  justify-content: space-between;\r\n  gap: clamp(1.5rem, 4vh, 3rem);\r\n}\r\n\r\n.hero-subline {\r\n  color: var(--ink-dim);\r\n  letter-spacing: 0.22em;\r\n  text-transform: uppercase;\r\n  font-size: clamp(0.72rem, 2.2vw, 0.9rem);\r\n}\r\n\r\n.hero-spacer {\r\n  flex: 1 1 auto;\r\n  width: 100%;\r\n  min-height: 20vh;\r\n}\r\n\r\n.enter-cta {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.7rem;\r\n  padding: 1rem 1.8rem;\r\n  border-radius: 999px;\r\n  border: 1px solid var(--edge-hi);\r\n  color: var(--ink);\r\n  font-weight: 600;\r\n  letter-spacing: 0.12em;\r\n  text-transform: uppercase;\r\n  font-size: 0.85rem;\r\n  background: rgba(255, 255, 255, 0.04);\r\n  backdrop-filter: blur(10px);\r\n  transition: background 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;\r\n  min-height: 48px;\r\n}\r\n\r\n.enter-cta:hover {\r\n  background: rgba(255, 255, 255, 0.1);\r\n  box-shadow: 0 0 40px -12px rgba(123, 92, 255, 0.8);\r\n}\r\n\r\n.enter-cta__arrow {\r\n  display: inline-flex;\r\n  transition: transform 0.3s ease;\r\n}\r\n\r\n.enter-cta:hover .enter-cta__arrow {\r\n  transform: translateX(4px);\r\n}\r\n\r\n.skip-intro {\r\n  background: transparent;\r\n  border: none;\r\n  color: var(--ink-faint);\r\n  font-size: 0.8rem;\r\n  letter-spacing: 0.12em;\r\n  text-transform: uppercase;\r\n  padding: 0.5rem 0.75rem;\r\n}\r\n\r\n.skip-intro:hover {\r\n  color: var(--ink-dim);\r\n}\r\n\r\n/* ============================================================ Forms */\r\n\r\n.field {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.55rem;\r\n  text-align: left;\r\n  margin-top: 0.5rem;\r\n}\r\n\r\n.field__label {\r\n  font-size: 0.85rem;\r\n  letter-spacing: 0.14em;\r\n  text-transform: uppercase;\r\n  color: var(--ink-dim);\r\n}\r\n\r\n.field__control {\r\n  position: relative;\r\n}\r\n\r\n.field__input {\r\n  width: 100%;\r\n  padding: 1rem 1.1rem;\r\n  border-radius: 14px;\r\n  background: rgba(6, 8, 16, 0.55);\r\n  border: 1px solid var(--edge);\r\n  color: var(--ink);\r\n  font-size: 1.05rem;\r\n  font-family: inherit;\r\n  transition: border-color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;\r\n  min-height: 52px;\r\n}\r\n\r\n.field__input::placeholder {\r\n  color: var(--ink-faint);\r\n}\r\n\r\n.field__input:focus {\r\n  outline: none;\r\n  border-color: rgba(123, 92, 255, 0.8);\r\n  box-shadow: 0 0 0 4px rgba(123, 92, 255, 0.18);\r\n  background: rgba(10, 12, 24, 0.7);\r\n}\r\n\r\n.field__glow {\r\n  position: absolute;\r\n  inset: -1px;\r\n  border-radius: 15px;\r\n  pointer-events: none;\r\n  opacity: 0;\r\n  background: linear-gradient(120deg, rgba(123, 92, 255, 0.5), rgba(47, 125, 255, 0.4));\r\n  filter: blur(10px);\r\n  transition: opacity 0.3s ease;\r\n}\r\n\r\n.field__control:focus-within .field__glow {\r\n  opacity: 0.7;\r\n}\r\n\r\n.field__error {\r\n  color: #ff9a9a;\r\n  font-size: 0.85rem;\r\n}\r\n\r\n/* ============================================================ Category grid */\r\n\r\n.category-grid {\r\n  border: none;\r\n  padding: 0;\r\n  margin: 0.5rem 0 1.5rem;\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 0.85rem;\r\n  text-align: left;\r\n}\r\n\r\n.category-tile {\r\n  position: relative;\r\n  display: block;\r\n}\r\n\r\n.category-tile input {\r\n  position: absolute;\r\n  opacity: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  margin: 0;\r\n  cursor: pointer;\r\n}\r\n\r\n.category-tile__inner {\r\n  display: block;\r\n  padding: 1.05rem 1.1rem;\r\n  border-radius: 18px;\r\n  border: 1px solid var(--edge);\r\n  background: rgba(255, 255, 255, 0.03);\r\n  transition: border-color 0.25s ease, background 0.25s ease, transform 0.2s ease, box-shadow 0.3s ease;\r\n}\r\n\r\n.category-tile:hover .category-tile__inner {\r\n  background: rgba(255, 255, 255, 0.06);\r\n  border-color: var(--edge-hi);\r\n}\r\n\r\n.category-tile__label {\r\n  display: block;\r\n  font-family: var(--font-display);\r\n  font-weight: 700;\r\n  font-size: 1.05rem;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.03em;\r\n  margin-bottom: 0.25rem;\r\n  padding-left: 1.6rem;\r\n}\r\n\r\n.category-tile__desc {\r\n  display: block;\r\n  color: var(--ink-faint);\r\n  font-size: 0.82rem;\r\n  padding-left: 1.6rem;\r\n}\r\n\r\n.category-tile__check {\r\n  position: absolute;\r\n  left: 1.1rem;\r\n  top: 1.15rem;\r\n  width: 18px;\r\n  height: 18px;\r\n  border-radius: 50%;\r\n  border: 1.5px solid var(--edge-hi);\r\n  transition: border-color 0.2s ease, box-shadow 0.2s ease;\r\n}\r\n\r\n.category-tile__check::after {\r\n  content: '';\r\n  position: absolute;\r\n  inset: 3px;\r\n  border-radius: 50%;\r\n  background: var(--cool);\r\n  transform: scale(0);\r\n  transition: transform 0.2s ease;\r\n}\r\n\r\n.category-tile.is-selected .category-tile__inner {\r\n  border-color: rgba(123, 92, 255, 0.9);\r\n  background: rgba(123, 92, 255, 0.12);\r\n  box-shadow: 0 0 30px -10px rgba(123, 92, 255, 0.7), inset 0 0 0 1px rgba(123, 92, 255, 0.4);\r\n}\r\n\r\n.category-tile.is-selected .category-tile__check {\r\n  border-color: var(--violet);\r\n}\r\n\r\n.category-tile.is-selected .category-tile__check::after {\r\n  transform: scale(1);\r\n  background: linear-gradient(120deg, var(--violet), var(--electric));\r\n}\r\n\r\n.category-tile input:focus-visible + .category-tile__inner {\r\n  outline: 2px solid var(--cool);\r\n  outline-offset: 2px;\r\n}\r\n\r\n/* ============================================================ Full-screen scenes */\r\n\r\n/* Every stage after category selection is a full-viewport cinematic scene —\r\n   not a small glass card. Big kinetic type over the live WebGL background,\r\n   with a soft radial vignette (a legibility aid, not a box) keeping text\r\n   readable while the environment stays active behind it. */\r\n\r\n.stage--scene {\r\n  position: relative;\r\n  width: 100%;\r\n  min-height: 100dvh;\r\n  margin: auto;\r\n  justify-content: center;\r\n  padding: clamp(1.5rem, 6vh, 4rem) clamp(1rem, 5vw, 3rem);\r\n}\r\n\r\n.scene__scrim {\r\n  position: absolute;\r\n  inset: -10% -20%;\r\n  z-index: 0;\r\n  pointer-events: none;\r\n  background: radial-gradient(\r\n    60% 55% at 50% 45%,\r\n    rgba(5, 6, 12, 0.74),\r\n    rgba(5, 6, 12, 0.34) 55%,\r\n    transparent 76%\r\n  );\r\n}\r\n\r\n.scene__inner {\r\n  position: relative;\r\n  z-index: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: clamp(0.9rem, 2.4vh, 1.6rem);\r\n  width: 100%;\r\n  max-width: 1000px;\r\n}\r\n\r\n.scene__kicker {\r\n  font-size: clamp(0.78rem, 2.4vw, 0.95rem);\r\n  letter-spacing: 0.4em;\r\n  text-transform: uppercase;\r\n  color: var(--accent);\r\n  font-weight: 600;\r\n}\r\n\r\n.scene__title {\r\n  font-family: var(--font-display);\r\n  font-weight: 800;\r\n  text-transform: uppercase;\r\n  font-size: clamp(2rem, 8.5vw, 6rem);\r\n  line-height: 1;\r\n  letter-spacing: -0.01em;\r\n  text-wrap: balance;\r\n  text-shadow: 0 2px 40px rgba(0, 0, 0, 0.6);\r\n  max-width: 18ch;\r\n}\r\n\r\n.scene__body {\r\n  color: var(--ink-dim);\r\n  font-size: clamp(1.02rem, 2.6vw, 1.3rem);\r\n  line-height: 1.6;\r\n  max-width: 48ch;\r\n  text-shadow: 0 1px 20px rgba(0, 0, 0, 0.7);\r\n}\r\n\r\n.scene__prompt {\r\n  color: var(--ink);\r\n  font-weight: 600;\r\n  font-size: clamp(1rem, 2.6vw, 1.2rem);\r\n}\r\n\r\n.scene__actions {\r\n  display: flex;\r\n  gap: 0.9rem;\r\n  flex-wrap: wrap;\r\n  justify-content: center;\r\n  margin-top: clamp(0.6rem, 2vh, 1.4rem);\r\n}\r\n\r\n.scene__note {\r\n  color: var(--accent);\r\n  font-weight: 600;\r\n}\r\n\r\n/* Mission checklist (third semester) */\r\n.scene__list {\r\n  list-style: none;\r\n  margin: 0.4rem 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.7rem;\r\n  width: min(560px, 92vw);\r\n  text-align: left;\r\n}\r\n\r\n.scene__check {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.85rem;\r\n  padding: 0.95rem 1.1rem;\r\n  border-radius: 16px;\r\n  border: 1px solid var(--edge);\r\n  background: rgba(10, 12, 22, 0.5);\r\n  color: var(--ink);\r\n  font-size: clamp(1rem, 2.4vw, 1.15rem);\r\n  transition: border-color 0.2s ease, background 0.2s ease;\r\n}\r\n\r\n.scene__check.is-done {\r\n  border-color: color-mix(in srgb, var(--accent) 60%, transparent);\r\n  background: color-mix(in srgb, var(--accent) 14%, rgba(10, 12, 22, 0.5));\r\n}\r\n\r\n.scene__check input {\r\n  position: absolute;\r\n  opacity: 0;\r\n}\r\n\r\n.scene__box {\r\n  flex: 0 0 auto;\r\n  width: 24px;\r\n  height: 24px;\r\n  border-radius: 8px;\r\n  border: 1.6px solid var(--edge-hi);\r\n  position: relative;\r\n  transition: background 0.2s ease, border-color 0.2s ease;\r\n}\r\n\r\n.scene__check.is-done .scene__box {\r\n  background: var(--accent);\r\n  border-color: var(--accent);\r\n}\r\n\r\n.scene__check.is-done .scene__box::after {\r\n  content: '';\r\n  position: absolute;\r\n  left: 8px;\r\n  top: 4px;\r\n  width: 5px;\r\n  height: 11px;\r\n  border: solid #07090f;\r\n  border-width: 0 2px 2px 0;\r\n  transform: rotate(45deg);\r\n}\r\n\r\n/* Fifth-semester choices */\r\n.scene__choices {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 0.9rem;\r\n  width: min(760px, 94vw);\r\n  margin-top: 0.6rem;\r\n}\r\n\r\n.scene__choice {\r\n  padding: clamp(1rem, 3vw, 1.6rem) 0.8rem;\r\n  border-radius: 18px;\r\n  border: 1px solid var(--edge);\r\n  background: rgba(255, 255, 255, 0.04);\r\n  color: var(--ink);\r\n  font-family: var(--font-display);\r\n  font-weight: 700;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.04em;\r\n  font-size: clamp(0.95rem, 2.4vw, 1.2rem);\r\n  min-height: 64px;\r\n  transition: border-color 0.25s ease, background 0.25s ease, transform 0.2s ease,\r\n    box-shadow 0.3s ease;\r\n}\r\n\r\n.scene__choice:hover {\r\n  border-color: var(--accent);\r\n  background: color-mix(in srgb, var(--accent) 16%, transparent);\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 16px 40px -18px color-mix(in srgb, var(--accent) 70%, transparent);\r\n}\r\n\r\n/* ============================================================ Invitation (full-screen) */\r\n\r\n.invitation__personal {\r\n  letter-spacing: 0.2em;\r\n  text-transform: uppercase;\r\n  font-size: 0.8rem;\r\n  color: var(--gold);\r\n  margin-bottom: 1.4rem;\r\n}\r\n\r\n.invitation__title {\r\n  font-family: var(--font-display);\r\n  font-weight: 800;\r\n  text-transform: uppercase;\r\n  font-size: clamp(2.6rem, 12vw, 5.5rem);\r\n  line-height: 0.9;\r\n  letter-spacing: 0.01em;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n}\r\n\r\n.invitation__title-primary {\r\n  background: linear-gradient(180deg, #fff, #cdd8ff 60%, rgba(160, 170, 220, 0.6));\r\n  -webkit-background-clip: text;\r\n  background-clip: text;\r\n  color: transparent;\r\n}\r\n\r\n.invitation__title-accent {\r\n  color: var(--gold);\r\n  background: linear-gradient(180deg, #ffe4b0, var(--gold) 60%, #b5772e);\r\n  -webkit-background-clip: text;\r\n  background-clip: text;\r\n  color: transparent;\r\n}\r\n\r\n.invitation__rule {\r\n  height: 1px;\r\n  width: 60%;\r\n  margin: 1.6rem auto;\r\n  background: linear-gradient(90deg, transparent, var(--gold), transparent);\r\n}\r\n\r\n.invitation__details {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));\r\n  gap: 1rem 1.4rem;\r\n  margin: 0 0 1.6rem;\r\n}\r\n\r\n.invitation__detail dt {\r\n  font-size: 0.72rem;\r\n  letter-spacing: 0.24em;\r\n  text-transform: uppercase;\r\n  color: var(--ink-faint);\r\n  margin-bottom: 0.3rem;\r\n}\r\n\r\n.invitation__detail dd {\r\n  margin: 0;\r\n  font-family: var(--font-display);\r\n  font-weight: 700;\r\n  font-size: clamp(1.05rem, 2.6vw, 1.15rem);\r\n  line-height: 1.3;\r\n  /* Event facts read as the uppercase composition specified for the invite. */\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.03em;\r\n}\r\n\r\n.invitation__organizer {\r\n  margin-bottom: 1.8rem;\r\n}\r\n\r\n.invitation__organizer-label {\r\n  display: block;\r\n  font-size: 0.72rem;\r\n  letter-spacing: 0.24em;\r\n  text-transform: uppercase;\r\n  color: var(--ink-faint);\r\n  margin-bottom: 0.45rem;\r\n}\r\n\r\n.invitation__organizer-name {\r\n  color: var(--ink-dim);\r\n  font-size: clamp(0.85rem, 2.4vw, 0.98rem);\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n/* ============================================================ Finale */\r\n\r\n.stage--finale {\r\n  position: relative;\r\n}\r\n\r\n.finale {\r\n  position: relative;\r\n  width: 100%;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: clamp(2rem, 6vh, 4rem);\r\n}\r\n\r\n.finale__veil {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: -1;\r\n  background: radial-gradient(60% 50% at 50% 55%, rgba(0, 0, 0, 0.2), rgba(3, 4, 8, 0.86));\r\n  opacity: 0;\r\n}\r\n\r\n.finale__credit {\r\n  position: relative;\r\n  text-align: center;\r\n  padding: 2rem 1rem;\r\n}\r\n\r\n.finale__line {\r\n  font-family: var(--font-display);\r\n  text-transform: uppercase;\r\n}\r\n\r\n.finale__line--made {\r\n  letter-spacing: 0.5em;\r\n  font-weight: 600;\r\n  font-size: clamp(0.8rem, 2.6vw, 1rem);\r\n  color: var(--ink-dim);\r\n  margin-bottom: 0.9rem;\r\n  padding-left: 0.5em;\r\n}\r\n\r\n.finale__line--name {\r\n  font-weight: 800;\r\n  /* Small-screen floor keeps \"NACHIKET MR.360\" inside narrow viewports\r\n     (320px) instead of overflowing the way the previous clamp did. */\r\n  font-size: clamp(1.5rem, 8vw, 4.5rem);\r\n  line-height: 1.05;\r\n  letter-spacing: 0.01em;\r\n  max-width: 92vw;\r\n  margin-inline: auto;\r\n  overflow-wrap: break-word;\r\n  background: linear-gradient(180deg, #fff5df 0%, var(--gold) 45%, #b07a2b 100%);\r\n  -webkit-background-clip: text;\r\n  background-clip: text;\r\n  color: transparent;\r\n  filter: drop-shadow(0 0 34px rgba(243, 198, 117, 0.45));\r\n}\r\n\r\n.finale__sweep {\r\n  position: absolute;\r\n  inset: 0;\r\n  pointer-events: none;\r\n  mix-blend-mode: overlay;\r\n  background: linear-gradient(100deg, transparent 40%, rgba(255, 255, 255, 0.9) 50%, transparent 60%);\r\n}\r\n\r\n.finale__controls {\r\n  display: flex;\r\n  gap: 0.8rem;\r\n  flex-wrap: wrap;\r\n  justify-content: center;\r\n}\r\n\r\n/* ============================================================ CSS fallback background */\r\n\r\n.fallback-bg {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 0;\r\n  overflow: hidden;\r\n  background: radial-gradient(120% 120% at 50% 0%, var(--bg-2), var(--bg) 70%);\r\n}\r\n\r\n.fallback-bg__glow {\r\n  position: absolute;\r\n  border-radius: 50%;\r\n  filter: blur(80px);\r\n  opacity: 0.45;\r\n  animation: fallback-float 18s ease-in-out infinite;\r\n}\r\n\r\n.fallback-bg__glow--a {\r\n  width: 46vw;\r\n  height: 46vw;\r\n  background: var(--violet);\r\n  top: -8%;\r\n  left: -6%;\r\n}\r\n\r\n.fallback-bg__glow--b {\r\n  width: 40vw;\r\n  height: 40vw;\r\n  background: var(--electric);\r\n  bottom: -10%;\r\n  right: -6%;\r\n  animation-delay: -6s;\r\n}\r\n\r\n.fallback-bg__glow--c {\r\n  width: 26vw;\r\n  height: 26vw;\r\n  background: var(--amber);\r\n  top: 40%;\r\n  left: 55%;\r\n  opacity: 0.22;\r\n  animation-delay: -12s;\r\n}\r\n\r\n.fallback-bg__grain {\r\n  position: absolute;\r\n  inset: 0;\r\n  opacity: 0.05;\r\n  background-image: radial-gradient(rgba(255, 255, 255, 0.6) 1px, transparent 1px);\r\n  background-size: 3px 3px;\r\n}\r\n\r\n@keyframes fallback-float {\r\n  0%,\r\n  100% {\r\n    transform: translate(0, 0) scale(1);\r\n  }\r\n  50% {\r\n    transform: translate(3%, -4%) scale(1.08);\r\n  }\r\n}\r\n\r\n/* ============================================================ Responsive */\r\n\r\n/* Fifth-semester choices collapse to a single stack on narrow screens so the\r\n   buttons stay readable and easy to tap. */\r\n@media (max-width: 560px) {\r\n  .scene__choices {\r\n    grid-template-columns: 1fr;\r\n    width: min(420px, 92vw);\r\n  }\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .category-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .glass-panel {\r\n    border-radius: 20px;\r\n  }\r\n\r\n  .panel__actions .btn {\r\n    flex: 1 1 auto;\r\n  }\r\n}\r\n\r\n@media (max-width: 420px) {\r\n  .invitation__details {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .controls__meter {\r\n    display: none;\r\n  }\r\n}\r\n\r\n/* Landscape phones: keep content reachable without rotating. */\r\n@media (max-height: 460px) and (orientation: landscape) {\r\n  .app__overlay {\r\n    align-items: flex-start;\r\n  }\r\n\r\n  .stage--hero {\r\n    min-height: 78vh;\r\n    gap: 0.75rem;\r\n  }\r\n\r\n  .hero-spacer {\r\n    min-height: 8vh;\r\n  }\r\n}\r\n\r\n/* ============================================================ Reduced motion */\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  * {\r\n    animation-duration: 0.001ms !important;\r\n    animation-iteration-count: 1 !important;\r\n    transition-duration: 0.001ms !important;\r\n    scroll-behavior: auto !important;\r\n  }\r\n\r\n  .fallback-bg__glow {\r\n    animation: none;\r\n  }\r\n\r\n  .stage--scene {\r\n    padding: clamp(1.25rem, 4vh, 2rem) clamp(1rem, 5vw, 2rem);\r\n  }\r\n}\r\n"
